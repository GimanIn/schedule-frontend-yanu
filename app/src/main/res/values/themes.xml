<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MyCalendar" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 배경을 흰색으로 설정 -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="colorPrimary">@android:color/darker_gray</item>

    </style>

    <style name="DayTextStyle">
        <item name="android:gravity">top|center_horizontal</item>
        <item name="android:paddingTop">8dp</item>
    </style>

    <style name="DayOfWeek">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/darker_gray</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ColorPickerCircle.Small">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/add_button_circle_background</item>
    </style>

    <style name="ColorPickerCircle" parent="ColorPickerCircle.Small" />

</resources>