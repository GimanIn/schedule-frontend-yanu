<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/white">

    <!-- 뒤로 가기 버튼 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_back"
        android:contentDescription="뒤로 가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 타이틀 -->
    <TextView
        android:id="@+id/titleChangePw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호 변경"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp"/>

    <!-- 현재 비밀번호 -->
    <EditText
        android:id="@+id/etCurrentPw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="현재 비밀번호"
        android:inputType="textPassword"
        android:background="@drawable/ic_roundedbox"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/titleChangePw"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp" />

    <!-- 새 비밀번호 -->
    <EditText
        android:id="@+id/etNewPw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="새 비밀번호"
        android:inputType="textPassword"
        android:background="@drawable/ic_roundedbox"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/etCurrentPw"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="6dp" />

    <!-- 새 비밀번호 확인 -->
    <EditText
        android:id="@+id/etConfirmPw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="새 비밀번호 확인"
        android:inputType="textPassword"
        android:background="@drawable/ic_roundedbox"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/etNewPw"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="6dp" />

    <!-- 변경 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChangePw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="변경하기"
        android:textColor="@android:color/white"
        android:backgroundTint="#999CAA"
        android:elevation="4dp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/etConfirmPw"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>