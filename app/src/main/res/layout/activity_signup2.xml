<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- 뒤로 가기 버튼 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_back"
        android:contentDescription="뒤로 가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 회원가입 텍스트 -->
    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="회원가입"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- '사용할 아이디를 입력해주세요' -->
    <TextView
        android:id="@+id/name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="사용할 아이디를 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        android:layout_marginTop="55dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 아이디 입력 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:hint="아이디 입력"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxStrokeColor="#999CAA"
        app:layout_constraintTop_toBottomOf="@id/name_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_overlap">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextId"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="text"
            android:textSize="14sp"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 중복 확인 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_overlap"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:text="중복 확인"
        android:textSize="13sp"
        android:textColor="@android:color/white"
        app:cornerRadius="8dp"
        app:backgroundTint="#999CAA"
        app:layout_constraintTop_toTopOf="@id/textInputLayoutId"
        app:layout_constraintBottom_toBottomOf="@id/textInputLayoutId"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 이름 검증 메시지 -->
    <LinearLayout
        android:id="@+id/message_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutId"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/icon_name"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_warning" />
        <TextView
            android:id="@+id/text_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이미 존재하는 아이디입니다."
            android:textSize="10sp"
            android:textColor="#FF0000" />
    </LinearLayout>

    <!-- '사용할 비밀번호를 입력해주세요' -->
    <TextView
        android:id="@+id/password_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="사용할 비밀번호를 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/message_id"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 비밀번호 입력 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/passwordLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="영문/특수기호/숫자, 8~16글자"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxStrokeColor="@color/black"
        app:endIconMode="password_toggle"
        app:layout_constraintTop_toBottomOf="@id/password_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </com.google.android.material.textfield.TextInputLayout>


    <!-- 눈 아이콘 -->
    <ImageView
        android:id="@+id/togglePw"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="15dp"
        android:src="@drawable/ic_visibility_off"
        android:contentDescription="비밀번호 보기 토글"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/passwordLayout"
        app:layout_constraintBottom_toBottomOf="@id/passwordLayout"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 새비밀번호 오류 메시지 -->
    <LinearLayout
        android:id="@+id/message_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/passwordLayout"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/icon_password"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_warning" />
        <TextView
            android:id="@+id/text_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="올바른 양식이 아닙니다. 다시 입력해주세요."
            android:textSize="10sp"
            android:textColor="#FF0000" />
    </LinearLayout>

    <!-- '다시 한 번 입력해주세요' -->
    <TextView
        android:id="@+id/re_password_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="다시 한 번 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/message_password"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 비밀번호 확인 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/rePasswordLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="비밀번호 재입력"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/black"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp"
        app:endIconMode="password_toggle"
        app:layout_constraintTop_toBottomOf="@id/re_password_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/re_password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 눈 아이콘 -->
    <ImageView
        android:id="@+id/toggle_rePw"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="15dp"
        android:src="@drawable/ic_visibility_off"
        android:contentDescription="비밀번호 보기 토글"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/rePasswordLayout"
        app:layout_constraintBottom_toBottomOf="@id/rePasswordLayout"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 새비밀번호 재확인 오류 메시지 -->
    <LinearLayout
        android:id="@+id/message_re_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/rePasswordLayout"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/icon_re_password"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_warning" />
        <TextView
            android:id="@+id/text_re_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="올바른 양식이 아닙니다. 다시 입력해주세요."
            android:textSize="10sp"
            android:textColor="#FF0000" />
    </LinearLayout>

    <!-- 회원가입 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_finish"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="회원가입 하기"
        android:textColor="#FAFAFA"
        android:textSize="18sp"
        android:enabled="false"
        app:cornerRadius="12dp"
        android:backgroundTint="#999CAA"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>