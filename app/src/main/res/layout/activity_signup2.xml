<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- 뒤로 가기 버튼 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_back"
        android:contentDescription="뒤로 가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 회원가입 텍스트 -->
    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="회원가입"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- '사용할 아이디를 입력해주세요' -->
    <TextView
        android:id="@+id/name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="사용할 아이디를 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        android:layout_marginTop="55dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 이름 입력창 만들기 -->
    <EditText
        android:id="@+id/editTextId"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:hint="아이디 입력"
        android:textSize="13sp"
        android:textColor="#000000"
        android:textColorHint="#AAAAAA"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/ic_roundedbox"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/name_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_overlap"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_overlap"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:text="중복 확인"
        android:textSize="12sp"
        android:background="@drawable/ic_roundedbox_dark"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toTopOf="@id/editTextId"
        app:layout_constraintBottom_toBottomOf="@id/editTextId"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 이름 검증 메시지 -->
    <LinearLayout
        android:id="@+id/message_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/editTextId"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/icon_name"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_warning" />
        <TextView
            android:id="@+id/text_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이미 존재하는 아이디입니다."
            android:textSize="10sp"
            android:textColor="#FF0000" />
    </LinearLayout>

    <!-- '사용할 비밀번호를 입력해주세요' -->
    <TextView
        android:id="@+id/password_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="사용할 비밀번호를 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/message_id"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 사용할 비밀번호 입력창 만들기 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/password"
        android:layout_width="358dp"
        android:layout_height="33dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/ic_roundedbox"
        android:gravity="center_vertical"
        android:hint="영문/특수기호/숫자, 8~16글자로 입력해주세요"
        android:inputType="phone"
        android:paddingHorizontal="12dp"
        android:textColor="#000000"
        android:textColorHint="#AAAAAA"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/password_text" />

    <!-- 눈 아이콘 -->
    <ImageView
        android:id="@+id/togglePw"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="15dp"
        android:src="@drawable/ic_visibility_off"
        android:contentDescription="비밀번호 보기 토글"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/password"
        app:layout_constraintBottom_toBottomOf="@id/password"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 새비밀번호 오류 메시지 -->
    <LinearLayout
        android:id="@+id/message_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/password"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/icon_password"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_warning" />
        <TextView
            android:id="@+id/text_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="올바른 양식이 아닙니다. 다시 입력해주세요."
            android:textSize="10sp"
            android:textColor="#FF0000" />
    </LinearLayout>

    <!-- '다시 한 번 입력해주세요' -->
    <TextView
        android:id="@+id/re_password_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="다시 한 번 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/message_password"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 비밀번호 확인 입력창 만들기 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/re_password"
        android:layout_width="358dp"
        android:layout_height="33dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/ic_roundedbox"
        android:gravity="center_vertical"
        android:hint="영문/특수기호/숫자, 8~16글자로 입력해주세요"
        android:inputType="phone"
        android:paddingHorizontal="12dp"
        android:textColor="#000000"
        android:textColorHint="#AAAAAA"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/re_password_text" />

    <!-- 눈 아이콘 -->
    <ImageView
        android:id="@+id/toggle_rePw"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="15dp"
        android:src="@drawable/ic_visibility_off"
        android:contentDescription="비밀번호 보기 토글"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/re_password"
        app:layout_constraintBottom_toBottomOf="@id/re_password"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 새비밀번호 재확인 오류 메시지 -->
    <LinearLayout
        android:id="@+id/message_re_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/re_password"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/icon_re_password"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_warning" />
        <TextView
            android:id="@+id/text_re_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="올바른 양식이 아닙니다. 다시 입력해주세요."
            android:textSize="10sp"
            android:textColor="#FF0000" />
    </LinearLayout>

    <!-- 하단 '회원가입 하기' 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_finish"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="회원가입 하기"
        android:textColor="#FAFAFA"
        android:textSize="18sp"
        android:background="@drawable/ic_roundedbox_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>