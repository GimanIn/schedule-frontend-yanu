<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- 뒤로 가기 버튼 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_back"
        android:contentDescription="뒤로 가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 회원가입 텍스트 -->
    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="회원가입"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- '사용자의 이름을 입력해주세요' -->
    <TextView
        android:id="@+id/id_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="사용할 아이디를 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        android:layout_marginTop="55dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 아이디 입력 -->
    <EditText
        android:id="@+id/editTextId"
        android:layout_width="250dp"
        android:layout_height="35dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/ic_roundedbox"
        android:gravity="center_vertical"
        android:hint="6~10글자로 입력해주세요"
        android:inputType="textPersonName"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="#000000"
        android:textColorHint="#AAAAAA"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/btn_overlap"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/id_text" />

    <!-- 중복확인 버튼 -->
    <Button
        android:id="@+id/btn_overlap"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/ic_roundedbox_dark"
        android:enabled="false"
        android:text="중복 확인"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/editTextId"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/editTextId" />

    <!-- 아이디 경고 메시지 -->
    <TextView
        android:id="@+id/id_warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="중복 확인 메시지"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/editTextId"
        app:layout_constraintStart_toStartOf="@id/editTextId"
        android:layout_marginTop="2dp" />

    <!-- '사용할 비밀번호를 입력해주세요' -->
    <TextView
        android:id="@+id/new_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="사용할 비밀번호를 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/btn_overlap"
        app:layout_constraintStart_toStartOf="@id/id_text"
        android:layout_marginTop="24dp" />

    <!-- 새로운 비밀번호 입력창 만들기 -->
    <LinearLayout
        android:id="@+id/input_password"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/ic_roundedbox"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/new_password"
        app:layout_constraintStart_toStartOf="@id/editTextId"
        app:layout_constraintEnd_toEndOf="@id/btn_overlap"
        android:layout_marginTop="8dp">
        <EditText
            android:id="@+id/btn_newpassword"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="영문 대/소문자 구분, 8~16글자로 입력해주세요"
            android:inputType="textPassword"
            android:background="@android:color/transparent"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:textSize="13sp" />
        <ImageView
            android:id="@+id/toggle_password"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_visibility_off"
            android:contentDescription="비밀번호 보기 토글"
            android:padding="8dp" />
    </LinearLayout>

    <!-- 비밀번호 경고 메시지 -->
    <TextView
        android:id="@+id/pw_warning_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호 입력 메시지"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/input_password"
        app:layout_constraintStart_toStartOf="@id/input_password"
        android:layout_marginTop="2dp" />

    <!-- '다시 한 번 입력해주세요' -->
    <TextView
        android:id="@+id/re_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="다시 한 번 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/input_password"
        android:layout_marginTop="15dp" />

    <!-- 비밀번호 확인 입력창 만들기 -->
    <LinearLayout
        android:id="@+id/input_re_password"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/ic_roundedbox"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/re_password"
        app:layout_constraintStart_toStartOf="@id/editTextId"
        app:layout_constraintEnd_toEndOf="@id/btn_overlap"
        android:layout_marginTop="8dp">
        <EditText
            android:id="@+id/btn_re_password"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="영문 대/소문자 구분, 8~16글자로 입력해주세요"
            android:inputType="textPassword"
            android:background="@android:color/transparent"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:textSize="13sp" />
        <ImageView
            android:id="@+id/toggle_password2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_visibility_off"
            android:contentDescription="비밀번호 보기 토글"
            android:padding="8dp" />
    </LinearLayout>

    <!-- 비밀번호 확인 경고 메시지 -->
    <TextView
        android:id="@+id/pw_confirm_warning_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호 확인 메시지"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/input_re_password"
        app:layout_constraintStart_toStartOf="@id/input_re_password"
        android:layout_marginTop="2dp"/>

    <!-- 회원가입하기 버튼 -->
    <Button
        android:id="@+id/btn_register"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="회원가입 하기"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:background="@drawable/ic_roundedbox_dark"
        android:enabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />


</androidx.constraintlayout.widget.ConstraintLayout>