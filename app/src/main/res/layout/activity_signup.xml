<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- 뒤로 가기 버튼 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_back"
        android:contentDescription="뒤로 가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 회원가입 텍스트 -->
    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="회원가입"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 이름 안내 -->
    <TextView
        android:id="@+id/name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="사용자의 이름을 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        android:layout_marginTop="55dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 이름 입력창 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/name_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:layout_constraintTop_toBottomOf="@id/name_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:inputType="textPersonName"
            android:hint="ex. 홍길동"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:textSize="13sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 이름 유효성 메시지 -->
    <LinearLayout
        android:id="@+id/message_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/name_layout"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/icon_name"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_warning" />
        <TextView
            android:id="@+id/text_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="올바른 양식이 아닙니다. 다시 입력해주세요."
            android:textSize="10sp"
            android:textColor="#FF0000" />
    </LinearLayout>

    <!-- 휴대폰 번호 안내 -->
    <TextView
        android:id="@+id/phone_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="휴대폰 번호를 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/name_layout"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 전화번호 입력창 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/phone_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#AAAAAA"
        app:layout_constraintTop_toBottomOf="@id/phone_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_send_code"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_phone"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:inputType="phone"
            android:hint="ex. 01012345678"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 인증번호 발송 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_send_code"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="인증번호 발송"
        android:textSize="13sp"
        android:enabled="false"
        android:textColor="@android:color/white"
        app:cornerRadius="8dp"
        app:backgroundTint="#999CAA"
        app:layout_constraintTop_toTopOf="@id/phone_layout"
        app:layout_constraintBottom_toBottomOf="@id/phone_layout"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 인증번호 발송 메시지 -->
    <LinearLayout
        android:id="@+id/message_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/phone_layout"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/icon_phone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_check" />
        <TextView
            android:id="@+id/text_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="인증번호가 발송되었습니다."
            android:textSize="10sp"
            android:textColor="#2BA600" />
        <TextView
            android:id="@+id/text_send_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(1/5)"
            android:textSize="10sp"
            android:textColor="#AAAAAA"
            android:layout_marginStart="100dp" />
    </LinearLayout>

    <!-- 인증번호 입력창 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/authcode_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#AAAAAA"
        app:layout_constraintTop_toBottomOf="@id/phone_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_check_code"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_auth_code"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:inputType="number"
            android:hint="인증번호 입력"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:paddingStart="12dp"
            android:paddingEnd="48dp"
            android:textSize="13sp"
            android:gravity="center_vertical" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 타이머 -->
    <TextView
        android:id="@+id/text_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3:00"
        android:textSize="13sp"
        android:textColor="#999CAA"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@id/authcode_layout"
        app:layout_constraintTop_toTopOf="@id/authcode_layout"
        app:layout_constraintBottom_toBottomOf="@id/authcode_layout"
        app:layout_constraintVertical_bias="0.5" />

    <!-- 인증번호 확인 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_check_code"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="인증번호 확인"
        android:textColor="#BDBDBD"
        android:textSize="13sp"
        android:enabled="false"
        app:backgroundTint="#999CAA"
        app:layout_constraintTop_toTopOf="@id/authcode_layout"
        app:layout_constraintBottom_toBottomOf="@id/authcode_layout"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 인증번호 검증 메시지 -->
    <LinearLayout
        android:id="@+id/message_cert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/authcode_layout"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/icon_cert"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_check" />
        <TextView
            android:id="@+id/text_cert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="인증번호가 일치합니다."
            android:textSize="10sp"
            android:textColor="#2BA600" />
    </LinearLayout>

    <!-- 약관 동의 -->
    <LinearLayout
        android:id="@+id/consent_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/btn_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="전체 동의"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#999CAA" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_terms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="(필수) 이용약관"
                android:textColor="#999CAA" />

            <TextView
                android:id="@+id/tv_view_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="전체 보기▾"
                android:textSize="12sp"
                android:textColor="#999999" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_privacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="(필수) 개인정보 수집 및 이용"
                android:textColor="#999CAA" />

            <TextView
                android:id="@+id/tv_view_privacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="전체 보기▾"
                android:textSize="12sp"
                android:textColor="#999999" />
        </LinearLayout>
    </LinearLayout>

    <!-- 다음 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="다음"
        android:textColor="#FAFAFA"
        android:textSize="18sp"
        app:backgroundTint="#999CAA"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
