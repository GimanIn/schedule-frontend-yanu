<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- 뒤로 가기 버튼 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_back"
        android:contentDescription="뒤로 가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 회원가입 텍스트 -->
    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="회원가입"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- '사용자의 이름을 입력해주세요' -->
    <TextView
        android:id="@+id/name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="사용자의 이름을 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        android:layout_marginTop="55dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 이름 입력창 만들기 -->
    <EditText
        android:id="@+id/et_name"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:hint="ex. 홍길동"
        android:textSize="13sp"
        android:textColor="#000000"
        android:textColorHint="#AAAAAA"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/ic_roundedbox"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@id/name_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- 이름 검증 메시지 -->
    <LinearLayout
        android:id="@+id/message_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/et_name"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/icon_name"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_warning" />
        <TextView
            android:id="@+id/text_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="올바른 양식이 아닙니다. 다시 입력해주세요."
            android:textSize="10sp"
            android:textColor="#FF0000" />
    </LinearLayout>

    <!-- '휴대폰 번호를 입력해주세요' -->
    <TextView
        android:id="@+id/phone_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="휴대폰 번호를 입력해주세요"
        android:textSize="17sp"
        android:textColor="#000000"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/et_name"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 전화번호 입력창 만들기 -->
    <EditText
        android:id="@+id/et_phone"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:hint="ex. 01012345678"
        android:textSize="13sp"
        android:inputType="phone"
        android:textColor="#000000"
        android:textColorHint="#AAAAAA"
        android:background="@drawable/ic_roundedbox"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/phone_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_send_code" />

    <!-- 인증번호 발송 버튼 -->
    <Button
        android:id="@+id/btn_send_code"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:text="인증번호 발송"
        android:textColor="#BDBDBD"
        android:textSize="13sp"
        android:background="@drawable/ic_roundedbox_dark"
        android:enabled="false"
        app:layout_constraintTop_toTopOf="@+id/et_phone"
        app:layout_constraintBottom_toBottomOf="@id/et_phone"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 인증번호 발송 메시지 -->
    <LinearLayout
        android:id="@+id/message_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/et_phone"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/icon_phone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_check" />
        <TextView
            android:id="@+id/text_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="인증번호가 발송되었습니다."
            android:textSize="10sp"
            android:textColor="#2BA600"/>
        <TextView
            android:id="@+id/text_send_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(1/5)"
            android:textSize="10sp"
            android:textColor="#AAAAAA"
            android:layout_marginStart="100dp" />
    </LinearLayout>

    <!-- 인증번호 입력창 만들기 -->
    <EditText
        android:id="@+id/et_auth_code"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:hint="인증번호 입력"
        android:textSize="13sp"
        android:inputType="number"
        android:textColor="#000000"
        android:textColorHint="#AAAAAA"
        android:background="@drawable/ic_roundedbox"
        android:paddingStart="12dp"
        android:paddingEnd="48dp"
        android:gravity="center_vertical"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/et_phone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_check_code" />

    <!-- 타이머 텍스트 (3:00) -->
    <TextView
        android:id="@+id/text_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3:00"
        android:textSize="13sp"
        android:textColor="#999CAA"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@id/et_auth_code"
        app:layout_constraintTop_toTopOf="@id/et_auth_code"
        app:layout_constraintBottom_toBottomOf="@id/et_auth_code"
        app:layout_constraintVertical_bias="0.5" />

    <!-- 인증번호 확인 버튼 -->
    <Button
        android:id="@+id/btn_check_code"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:text="인증번호 확인"
        android:textColor="#BDBDBD"
        android:textSize="13sp"
        android:background="@drawable/ic_roundedbox_dark"
        android:enabled="false"
        app:layout_constraintTop_toTopOf="@+id/et_auth_code"
        app:layout_constraintBottom_toBottomOf="@id/et_auth_code"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 인증번호 검증 메시지 -->
    <LinearLayout
        android:id="@+id/message_cert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_auth_code"
        tools:layout_editor_absoluteY="321dp">

        <ImageView
            android:id="@+id/icon_cert"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="bottom"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_check" />

        <TextView
            android:id="@+id/text_cert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="인증번호가 일치합니다."
            android:textColor="#2BA600"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 동의조항 -->
    <LinearLayout
        android:id="@+id/consent_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

        <!-- 전체 동의 -->
        <CheckBox
            android:id="@+id/cb_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="전체 동의"
            android:textStyle="bold" />

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#999CAA" />

        <!-- 개별 동의 항목 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <CheckBox
                android:id="@+id/cb_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#999CAA"
                android:text="(필수) 이용약관"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/tv_view_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="전체 보기▾"
                android:textSize="12sp"
                android:textColor="#999999" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <CheckBox
                android:id="@+id/cb_privacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(필수) 개인정보 수집 및 이용"
                android:textColor="#999CAA"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/tv_view_privacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="전체 보기▾"
                android:textSize="12sp"
                android:textColor="#999999" />
        </LinearLayout>

    </LinearLayout>

    <!-- 하단 고정 버튼 -->
    <Button
        android:id="@+id/btn_next"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="다음"
        android:textColor="#FAFAFA"
        android:textSize="18sp"
        android:background="@drawable/ic_roundedbox_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>